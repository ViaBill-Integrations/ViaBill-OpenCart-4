<div class="d-inline-block pt-2 pd-2 w-100">
  {% if test_mode %}
    <div class="alert alert-warning">
      <i class="fa-solid fa-circle-info"></i> {{ text_test_mode_warning }}
    </div>
  {% endif %}

  {% if legal_note %}
    {# legal_note is sanitized HTML and legal_note_style is escaped CSS, see the
       catalog model getLegalNote() and getLegalNoteStyle() #}
    <link href="{{ legal_note_css }}" rel="stylesheet" />
    <div class="viabill-legal-note"{% if legal_note_style %} style="{{ legal_note_style }}"{% endif %}>
      <span class="viabill-legal-note-paying-with">{{ legal_note_paying_with|e }}</span>
      <span class="viabill-legal-note-logo"><img src="{{ legal_note_logo|e }}" alt="ViaBill" /></span>
      <span class="viabill-legal-note-text">{{ legal_note }}</span>
    </div>
  {% endif %}

  <div class="text-end">
    <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm }}</button>
  </div>
</div>

<script type="text/javascript">
$('#button-confirm').on('click', function() {
  $.ajax({
    url: 'index.php?route=extension/viabill/payment/viabill.confirm',
    dataType: 'json',
    cache: false,
    beforeSend: function() {
      $('#button-confirm').button('loading');
    },
    complete: function() {
      $('#button-confirm').button('reset');
    },
    success: function(json) {
      if (json['redirect']) {
        location = json['redirect'];
      }
      
      if (json['error']) {
        alert(json['error']);
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
});
</script>
